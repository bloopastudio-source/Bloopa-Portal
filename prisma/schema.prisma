generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum Role {
  ADMIN
  MANAGER
  TEAM
  CLIENT
}

enum CalendarStatus {
  NOT_STARTED
  IN_PROGRESS
  READY
  APPROVED
  POSTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum InvoiceStatus {
  PENDING
  PAID
}

enum ShootStatus {
  PLANNED
  COMPLETE
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String?
  emailVerified Boolean @default(false)
  image     String?
  role      Role
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clientMembers ClientMember[]
  tasks     Task[]
  messages  Message[]
  approvals Approval[]
}

model Client {
  id          String   @id @default(uuid())
  name        String
  industry    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     ClientMember[]
  tasks       Task[]
  calendarItems CalendarItem[]
  deliverables Deliverable[]
  messages    Message[]
  brandAssets  BrandAsset[]
  credentials  Credential[]
  approvals    Approval[]
  shoots       Shoot[]
  invoices     Invoice[]
  reports      Report[]
}

model ClientMember {
  id        String   @id @default(uuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  roleLabel String?
  createdAt DateTime @default(now())
  
  @@unique([clientId, userId])
}

model Task {
  id        String   @id @default(uuid())
  title     String
  status    TaskStatus @default(TODO)
  assignedTo User?   @relation(fields: [assignedToId], references: [id])
  assignedToId String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CalendarItem {
  id        String   @id @default(uuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  date      DateTime
  platform  String
  type      String
  assignedTeam String
  status    CalendarStatus
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([clientId])
  @@index([date])
  @@index([clientId, date])
}

model Deliverable {
  id        String   @id @default(uuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  type      String
  promised  Int
  delivered Int
  delayed   Int
  revisions Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Approval {
  id        String   @id @default(uuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  title     String
  assetUrl  String
  status    ApprovalStatus
  feedback  String?
  requestedBy User @relation(fields: [requestedById], references: [id])
  requestedById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id        String   @id @default(uuid())
  content   String
  sender    User     @relation(fields: [senderId], references: [id])
  senderId  String
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String?
  createdAt DateTime @default(now())
}

model BrandAsset {
  id        String   @id @default(uuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  type      String
  label     String
  url       String
  createdAt DateTime @default(now())
}

model Credential {
  id        String   @id @default(uuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  service   String
  username  String
  encryptedValue String
  createdAt DateTime @default(now())
}

model Shoot {
  id        String   @id @default(uuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  date      DateTime
  location  String
  people    String
  props     String
  status    ShootStatus
  createdAt DateTime @default(now())
}

model Invoice {
  id        String   @id @default(uuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  amount    Decimal  @db.Decimal(10, 2)
  status    InvoiceStatus
  issuedAt  DateTime
  createdAt DateTime @default(now())
}

model Expense {
  id        String   @id @default(uuid())
  category  String
  description String
  amount    Decimal  @db.Decimal(10, 2)
  incurredAt DateTime
  createdAt DateTime @default(now())
}

model Report {
  id        String   @id @default(uuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  month     String
  onTimePercentage Decimal @db.Decimal(5, 2)
  createdAt DateTime @default(now())
}